# ─── App ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── Security ────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-secure-random-string-at-least-64-chars

JWT_ACCESS_EXPIRES_IN=3600
JWT_DEVICE_EXPIRES_IN=900
JWT_REFRESH_USER_EXPIRES_IN=604800
JWT_REFRESH_DEVICE_EXPIRES_IN=2592000

# ─── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sentja_user:your_password@localhost:5432/sentja_db

# ─── Hetzner Storage Box SFTP ────────────────────────────────────────────
HETZNER_SFTP_HOST=uXXXXXX.your-storagebox.de
HETZNER_SFTP_PORT=23
HETZNER_SFTP_USER=uXXXXXX
HETZNER_SFTP_PASSWORD=your_storagebox_password
HETZNER_BASE_PATH=/sentja

# ─── CORS ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,https://admin.yourdomain.com

# ─── Rate Limiting ───────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PUBLIC=100
RATE_LIMIT_MAX_DEVICE=1000
