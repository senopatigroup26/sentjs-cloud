<Window x:Class="SentjaTray.MigrationStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cloud Sync Status — Sentja Cloud"
        Width="560" Height="500"
        MinWidth="480" MinHeight="400"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="#f4f6fa">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="#1a1a2e" Padding="24,18">
      <StackPanel>
        <TextBlock Text="Cloud Sync Status" FontSize="18" FontWeight="Bold"
                   Foreground="White"/>
        <TextBlock x:Name="SubtitleText" Text="Loading..."
                   FontSize="12" Foreground="#aaaacc" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <!-- Content -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
      <StackPanel Margin="20,16,20,8">

        <!-- Stats Cards Row -->
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Total Files -->
          <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="16,14">
            <StackPanel>
              <TextBlock Text="TOTAL FILES" FontSize="10" FontWeight="SemiBold"
                         Foreground="#888888" Margin="0,0,0,6"/>
              <TextBlock x:Name="TotalFilesText" Text="0"
                         FontSize="26" FontWeight="Bold" Foreground="#1a1a2e"/>
            </StackPanel>
          </Border>

          <!-- Synced -->
          <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="16,14">
            <StackPanel>
              <TextBlock Text="SYNCED" FontSize="10" FontWeight="SemiBold"
                         Foreground="#888888" Margin="0,0,0,6"/>
              <TextBlock x:Name="SyncedFilesText" Text="0"
                         FontSize="26" FontWeight="Bold" Foreground="#48bb78"/>
            </StackPanel>
          </Border>

          <!-- Uploaded Size -->
          <Border Grid.Column="4" Background="White" CornerRadius="10" Padding="16,14">
            <StackPanel>
              <TextBlock Text="UPLOADED" FontSize="10" FontWeight="SemiBold"
                         Foreground="#888888" Margin="0,0,0,6"/>
              <TextBlock x:Name="UploadedBytesText" Text="0 B"
                         FontSize="26" FontWeight="Bold" Foreground="#667eea"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Progress Bar -->
        <Border Background="White" CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
          <StackPanel>
            <DockPanel Margin="0,0,0,8">
              <TextBlock Text="Sync Progress" FontSize="13" FontWeight="SemiBold"
                         Foreground="#1a1a2e"/>
              <TextBlock x:Name="ProgressPctText" Text="0%"
                         FontSize="13" FontWeight="SemiBold" Foreground="#667eea"
                         HorizontalAlignment="Right" DockPanel.Dock="Right"/>
            </DockPanel>
            <Border Background="#f0f0f5" CornerRadius="4" Height="8">
              <Border x:Name="ProgressFill" Background="#667eea" CornerRadius="4"
                      HorizontalAlignment="Left" Width="0"/>
            </Border>
            <TextBlock x:Name="ProgressDetailText" Text="No files synced yet"
                       FontSize="12" Foreground="#888" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>

        <!-- Device Info -->
        <Border Background="White" CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Device Information" FontSize="13" FontWeight="SemiBold"
                       Foreground="#1a1a2e" Margin="0,0,0,10"/>
            <Grid x:Name="DeviceInfoGrid"/>
          </StackPanel>
        </Border>

        <!-- Recent Files -->
        <Border Background="White" CornerRadius="10" Padding="16,14">
          <StackPanel>
            <TextBlock Text="Recent Files" FontSize="13" FontWeight="SemiBold"
                       Foreground="#1a1a2e" Margin="0,0,0,10"/>
            <StackPanel x:Name="RecentFilesPanel"/>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- Footer -->
    <Border Grid.Row="2" Background="White" Padding="20,12"
            BorderBrush="#e8e8ee" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock x:Name="LastRefreshText" Text="" FontSize="11"
                   Foreground="#aaa" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
          <Button x:Name="StartSyncBtn" Content="▶  Sync Now"
                  Padding="16,8" Margin="0,0,8,0"
                  Background="#48bb78" Foreground="White" BorderThickness="0"
                  Cursor="Hand" Click="OnSyncNow">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <Button Content="↺  Refresh" Padding="16,8" Margin="0,0,8,0"
                  Background="#667eea" Foreground="White" BorderThickness="0"
                  Cursor="Hand" Click="OnRefresh">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <Button Content="Close" Padding="16,8"
                  Background="#e8e8ee" Foreground="#333" BorderThickness="0"
                  Cursor="Hand" Click="OnClose">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
