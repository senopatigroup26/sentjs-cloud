{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning"
      }
    }
  },
  "Sentja": {
    "ApiBaseUrl": "https://api.yourdomain.com",
    "SyncRootPath": "C:\\SentjaCloud",
    "LocalCachePath": "C:\\ProgramData\\Sentja\\Cache",
    "LocalDbPath": "C:\\ProgramData\\Sentja\\sentja.db",
    "MaxCacheSizeGB": 10,
    "HeartbeatIntervalSeconds": 60,
    "TokenRefreshBufferSeconds": 300
  }
}
